<?xml version="1.0"?>
<package format="3">
  <name>unitree_g1_kinematics</name>
  <version>0.1.0</version>
  <description>G1 URDF kinematics from FAST-LIO's Mid-360 pose to planar base_nav and the real waist base_link.</description>
  <maintainer email="unitree@example.com">unitree</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>eigen</depend>
  <depend>unitree_sdk2</depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
