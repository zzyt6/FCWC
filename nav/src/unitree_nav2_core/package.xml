<?xml version="1.0"?>
<package format="3">
  <name>unitree_nav2_core</name>
  <version>0.1.0</version>
  <description>Foxy-native PCD map conversion and localization frame adapters for Unitree G1 Nav2.</description>
  <maintainer email="unitree@example.com">unitree</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>dwb_core</depend>
  <depend>dwb_plugins</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_regulated_pure_pursuit_controller</depend>
  <depend>nav_2d_utils</depend>
  <depend>nav2_util</depend>
  <depend>pluginlib</depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
